# ============================================
# Cloudflare R2 对象存储配置
# ============================================

# 存储提供商，当前只支持 r2（兼容 S3 协议的对象存储均可使用）
STORAGE_PROVIDER=r2

# R2 存储桶的 S3 API 端点地址（Cloudflare 控制台 → R2 → 存储桶详情页获取）
STORAGE_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com

# R2 存储桶名称
STORAGE_BUCKET=chat-files

# R2 API 访问密钥 ID（Cloudflare 控制台 → R2 → 管理 API 令牌）
STORAGE_ACCESS_KEY=<your-access-key>

# R2 API 机密访问密钥（与 Access Key 配套生成，仅首次创建时显示，请妥善保存）
STORAGE_SECRET_KEY=<your-secret-key>

# 文件的公开访问地址前缀，末尾不加斜杠
#
# 方式一：使用 R2 自带 r2.dev 域名（开发测试用，有速率限制，生产勿用）
#   STORAGE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
#   代码会自动在 URL 路径中追加存储桶名
#
# 方式二：绑定自定义域名（推荐，生产必做）
#   1. Cloudflare 控制台 → R2 → 存储桶 → Settings → Custom Domains → Connect Domain
#   2. 绑定成功后自定义域名直接指向存储桶根目录，地址只需填写域名本身：
#      STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
#   3. 如果自定义域名未绑定到存储桶（或绑定未生效），你需要手动在地址中包含桶名，
#      否则生成的 URL 会缺少桶名导致 404：
#      STORAGE_PUBLIC_URL=https://cdn.yourdomain.com/chat-files
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com

# 区域设置，R2 固定为 auto
STORAGE_REGION=auto

# ============================================
# 文件上传限制
# ============================================

# 单个文件最大体积（字节），默认 10MB（10485760）
MAX_FILE_SIZE=10485760

# 预签名上传 URL 有效时长（秒），默认 300 秒（5 分钟）
UPLOAD_URL_EXPIRY=300

# ============================================
# WebRTC P2P 与中继配置
# ============================================

# --- 方式一：内建 TURN 中继（推荐，零配置）---
# 程序启动时自动启动内建 TURN 中继服务，无需搭建或购买外部 TURN 服务器。
# 内建中继复用服务器自身的 UDP 端口，P2P 直连失败时自动回退中转。
#
# 是否启用内建 TURN 中继（默认启用）
# TURN_RELAY_ENABLED=true
#
# 中继 UDP 端口（0 = 自动分配可用端口，默认 0）
# TURN_RELAY_PORT=0
#
# 服务器公网 IP（用于生成 relay ICE 候选，留空则自动检测）
#  重要：如果服务器在 NAT 后面（如部分云主机），必须手动填写公网 IP
#  否则 relay 候选地址为内网 IP，对方无法连接
# TURN_RELAY_PUBLIC_IP=
#
# 中继 HMAC 密钥（留空则每次启动自动生成随机密钥）
# TURN_RELAY_SECRET=

# --- 方式二：外部 TURN 服务器（如 coturn）---
# 不配置 TURN 时仅使用 Google 公共 STUN，局域网和多数 NAT 场景可直连。
# 如需在内网隔离、对称 NAT 等极端环境下保证连通，请部署 coturn 并填写以下参数。
#
# TURN_SERVER_URLS=turn:your-server.com:3478?transport=udp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# ============================================
# 部署提示：R2 存储桶 CORS 配置（必做）
# ============================================
#
# 浏览器直传文件到 R2 属于跨域请求，必须在 R2 控制台添加 CORS 策略。
# 注意：R2 CORS 策略必须使用 JSON 格式，不是键值对格式。
#
#   Cloudflare 控制台 → R2 → 存储桶 → Settings → CORS Policy → Add CORS Policy → 切换到 JSON 标签页：
#
#   [
#     {
#       "AllowedOrigins": ["http://localhost:21451"],
#       "AllowedMethods": ["GET", "PUT"],
#       "AllowedHeaders": ["Content-Type", "Content-Disposition"],
#       "ExposeHeaders": ["ETag"],
#       "MaxAgeSeconds": 3600
#     }
#   ]
#
# 字段说明：
#   AllowedOrigins  - 允许的请求来源，R2 要求精确匹配，不能只写 *。本地开发用 http://localhost:21451，
#                     生产环境改为你的域名如 https://chat.example.com，局域网访问用 http://192.168.x.x:21451
#   AllowedMethods  - 允许的 HTTP 方法，浏览器直传至少需要 GET PUT
#   AllowedHeaders  - 客户端上传时携带的请求头，Content-Disposition 用于保留原始文件名
#   ExposeHeaders   - 允许 JS 读取的响应头，ETag 用于校验上传完整性
#   MaxAgeSeconds   - 预检请求缓存时间（秒）
